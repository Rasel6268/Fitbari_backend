# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fitbari

# JWT Authentication
JWT_SECRET=fitbari_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Configuration (Client Origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ImageKit Media Storage Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM="Fit Bari <noreply@fitbari.com>"

